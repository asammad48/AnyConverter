+];
+
+const LOCALIZED_STRINGS = {
+  en: ['Export Draft', 'Export Video', 'Properties Inspector', 'Cinematic Shot Editor', 'Move Up', 'Move Down'],
+  es: ['Exportar Borrador', 'Exportar Video', 'Inspector de Propiedades', 'Editor de Tomas Cinemáticas', 'Subir', 'Bajar'],
+  da: ['Eksporter Kladde', 'Eksporter Video', 'Egenskaber', 'Filmisk Scene Editor', 'Flyt Op', 'Flyt Ned']
+};
+
+const REQUIRED_MOTIF_VALUES = [
+  'default',
+  'data-chaos',
+  'latency-bottleneck',
+  'wasm-pipeline',
+  'metric-counter',
