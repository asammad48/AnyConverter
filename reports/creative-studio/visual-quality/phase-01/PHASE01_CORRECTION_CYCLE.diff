+  'id="cs-shot-accent"',
+  'id="cs-shot-duration"',
+  'id="cs-canvas"',
+  'id="cs-timeline-scrubber"',
+  'id="cs-btn-play-pause"',
+  'id="cs-btn-save-project"',
+  'id="cs-btn-open-project"',
+  'id="cs-btn-shot-move-up"',
+  'id="cs-btn-shot-move-down"',
+  'id="cs-btn-export-draft"',
