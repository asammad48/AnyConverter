{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Creative Studio cinematic shot layout",
  "description": "Optional customData.layout field. Absence selects the original Phase 01 renderer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "preset"],
  "properties": {
    "version": { "const": 1 },
    "preset": { "enum": ["hero", "comparison", "statistic", "dialogue", "character-right", "character-center", "reaction", "reveal", "product", "silhouette", "punchline"] },
    "palette": { "enum": ["light", "dark"] },
    "pose": { "enum": ["standard", "large"] },
    "letterbox": { "type": "boolean" },
    "allowOverlap": { "type": "boolean" },
    "blocks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/definitions/layoutConstraint" },
        "subject": { "$ref": "#/definitions/layoutConstraint" },
        "caption": { "$ref": "#/definitions/layoutConstraint" }
      }
    }
  },
  "definitions": {
    "layoutConstraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchor": { "enum": ["", "left", "center", "right", "top", "bottom"] },
        "align": { "enum": ["left", "center", "right"] },
        "relativeTo": { "enum": ["", "title", "subject", "caption"] },
        "depth": { "enum": ["", "background", "midground", "foreground"] },
        "intrinsic": { "type": "boolean" },
        "baseline": { "type": "boolean" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "pixelX": { "type": "number" },
        "pixelY": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "maxWidth": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "maxHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "minSize": { "type": "number", "minimum": 0 },
        "gap": { "type": "number", "minimum": 0 }
      }
    }
  }
}
